www.aureviagaming.com {
    redir https://aureviagaming.com{uri} permanent
}

aureviagaming.com {
    encode zstd gzip

    @next_static path /_next/static/*
    header @next_static Cache-Control "public, max-age=31536000, immutable"

    @media path /media/*
    header @media {
        Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
        Cloudflare-CDN-Cache-Control "public, s-maxage=2592000, stale-while-revalidate=86400"
    }

    @api path /api/*
    header @api Cache-Control "no-store"

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output file /var/log/caddy/aureviagaming.access.log {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
