SITE_URL=https://staging.aureviagaming.com

# Public value embedded into the staging build by GitHub Actions as well.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_staging_site_key

# Staging-only server-side Turnstile validation.
TURNSTILE_SECRET_KEY=replace_with_staging_secret
TURNSTILE_ALLOWED_HOSTNAMES=staging.aureviagaming.com

# Keep staging analytics disabled by leaving this empty.
NEXT_PUBLIC_GA_ID=

# Use a dedicated test endpoint, never the production contact destination.
CONTACT_WEBHOOK_URL=https://replace-with-test-endpoint.example/contact
CONTACT_WEBHOOK_BEARER_TOKEN=
