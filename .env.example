# Canonical production URL used by metadata, sitemap, redirects and origin checks.
SITE_URL=https://aureviagaming.com

# Public values are embedded into the browser bundle during `npm run build`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

# Turnstile server-side validation. Keep the secret server-only.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=aureviagaming.com,www.aureviagaming.com

# Choose one contact delivery method. Telegram Bot delivery is usually simplest.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional generic webhook alternative.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=
