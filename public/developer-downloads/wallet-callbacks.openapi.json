{
  "openapi": "3.1.0",
  "info": {
    "title": "Aurevia Gaming Play’n GO Wallet Callbacks",
    "version": "1.0.1",
    "description": "Implement these four endpoints on your wallet server. Signed callbacks use exact raw request bytes; financial mutations and immutable responses must commit atomically. This sandbox uses simulated funds only."
  },
  "servers": [
    {
      "url": "https://wallet.client.example/playngo",
      "description": "Replace with your approved callback base URL."
    }
  ],
  "x-release-status": "sandbox",
  "security": [
    {
      "WalletHmac": []
    }
  ],
  "paths": {
    "/balance": {
      "post": {
        "operationId": "walletBalance",
        "summary": "Balance on client wallet",
        "description": "Read authoritative balance without mutation.",
        "parameters": [
          {
            "name": "x-pp-timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,12}$"
            },
            "description": "Unix seconds. Maximum clock skew 300 seconds."
          },
          {
            "name": "x-pp-request-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Must equal body request_id; changes per delivery attempt."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BalanceRequest"
              },
              "example": {
                "operator_id": "client-a",
                "player_id": "player-123",
                "session_id": "ses_example_01",
                "game_symbol": "wildframes",
                "currency": "EUR",
                "request_id": "req_balance_example_01",
                "transaction_id": "txn_balance_example_01",
                "transaction_type": "balance",
                "action_type": "balance",
                "amount": "0.00"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or explicit business rejection",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/WalletSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/WalletError"
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "balance": "98.00",
                  "currency": "EUR",
                  "transaction_id": "txn_balance_example_01"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature or stale timestamp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletError"
                }
              }
            }
          },
          "403": {
            "description": "Ownership violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletError"
                }
              }
            }
          },
          "409": {
            "description": "Transaction ID conflicts with original logical request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletError"
                }
              }
            }
          },
          "503": {
            "description": "Temporary failure; operation outcome may be unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletError"
                }
              }
            }
          }
        }
      }
    },
    "/debit": {
