    "/rollback": {
      "post": {
        "operationId": "walletRollback",
        "summary": "Rollback on client wallet",
        "description": "Idempotently refund/cancel original debit. If missing, persist cancellation marker to prevent a late debit. Deduplicate by original reference as well as rollback ID.",
        "parameters": [
          {
            "name": "x-pp-timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,12}$"
            },
            "description": "Unix seconds. Maximum clock skew 300 seconds."
          },
          {
            "name": "x-pp-request-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Must equal body request_id; changes per delivery attempt."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollbackRequest"
              },
              "example": {
                "operator_id": "client-a",
                "player_id": "player-123",
                "session_id": "ses_example_01",
                "game_symbol": "wildframes",
                "currency": "EUR",
                "request_id": "req_rollback_example_01",
                "transaction_id": "txn_rollback_example_01",
                "transaction_type": "rollback",
                "action_type": "rollback",
                "amount": "2.00",
                "round_id": "rnd_example_01",
                "round_closed": true,
                "original_transaction_id": "txn_debit_example_01"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or explicit business rejection",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/WalletSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/WalletError"
                    }
