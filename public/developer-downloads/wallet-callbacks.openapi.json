                "session_id": "ses_example_01",
                "game_symbol": "wildframes",
                "currency": "EUR",
                "request_id": "req_debit_example_01",
                "transaction_id": "txn_debit_example_01",
                "transaction_type": "debit",
                "action_type": "spin",
                "amount": "2.00",
                "round_id": "rnd_example_01",
                "round_closed": false
