  "components": {
    "securitySchemes": {
      "WalletHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "x-pp-signature",
        "description": "Not a static key. Lowercase hex HMAC-SHA256(secret, ASCII(timestamp) + dot + exact raw body bytes). Check timestamp and request ID headers, endpoint transaction_type, and ownership. Fresh signature per retry; stable logical transaction ID."
      }
    },
    "schemas": {
      "WalletSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "balance": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,13})\\.[0-9]{2}$",
            "examples": [
              "2.00"
            ],
            "description": "Exact decimal string, two fractional digits. Use integer minor units or a decimal type."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "EUR"
            ],
            "description": "Enabled two-fractional-digit currency only."
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "success",
          "balance",
          "currency",
          "transaction_id"
        ],
        "additionalProperties": false
      },
      "WalletError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "enum": [
              "insufficient_funds",
              "unknown_player",
              "currency_mismatch",
              "player_blocked",
              "transaction_cancelled",
              "invalid_signature",
              "stale_timestamp",
              "forbidden",
              "invalid_request",
              "idempotency_conflict",
              "temporarily_unavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "success",
          "error",
          "message"
        ],
        "additionalProperties": false
      },
      "BalanceRequest": {
        "type": "object",
        "properties": {
          "operator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "player_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "game_symbol": {
            "type": "string",
            "enum": [
              "demon",
              "honeyrush",
              "hugosadventure",
              "legacyofegypt",
              "moonprincess",
              "secretofdead",
              "trollhunters2",
              "wheelofmictlan",
              "wildframes"
            ],
            "description": "Initial candidate symbols. Actual assigned/enabled catalog is authoritative."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "EUR"
            ],
            "description": "Enabled two-fractional-digit currency only."
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "transaction_type": {
            "type": "string",
            "const": "balance"
          },
          "action_type": {
            "type": "string",
            "const": "balance"
          },
          "amount": {
            "type": "string",
            "const": "0.00"
          }
        },
        "required": [
          "operator_id",
