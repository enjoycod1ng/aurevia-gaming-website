{
  "openapi": "3.1.0",
  "info": {
    "title": "Aurevia Gaming Play’n GO Provider API",
    "version": "1.0.1",
    "description": "Sandbox callback-wallet integration. Simulated funds only. Game availability is assigned per operator; query the games endpoint for your enabled catalog. See the integration guide for onboarding and tested limits."
  },
  "servers": [
    {
      "url": "https://aureviagaming.com/playngo-sandbox",
      "description": "Sandbox; simulated funds only"
    }
  ],
  "x-release-status": "sandbox",
  "security": [
    {
      "OperatorKey": []
    },
    {
      "OperatorBearer": []
    }
  ],
  "paths": {
    "/api/provider/v1/games": {
      "get": {
        "operationId": "listPlaynGoGames",
        "summary": "List games assigned to the operator",
        "parameters": [
          {
            "name": "provider_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "playngo"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "operator_id": "client-a",
                    "provider_id": "playngo",
                    "total": 1,
                    "items": [
                      {
                        "symbol": "wildframes",
                        "slug": "wildframes",
                        "title": "Wild Frames",
                        "provider_id": "playngo",
                        "launch_status": "stable"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid operator key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Inactive operator or disallowed resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retry.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
