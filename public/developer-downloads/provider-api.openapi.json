    "/api/provider/v1/launch-url": {
      "post": {
        "operationId": "createPlaynGoLaunch",
        "summary": "Create a launch bound to an authenticated player",
        "description": "Idempotent under the same operator/environment and exact request. Identical retries retain the original response and expiry. Launch tickets are single use and expire after 60 seconds. Request a new launch with a new key after consumption/expiry. Sessions expire after 30 minutes idle or four hours absolute; settlement continues. An unused ticket reserves session capacity until expiry. Close sessions when leaving or switching games. HTTP 503 capacity_reached or maintenance includes Retry-After: 5; retry with the same launch key and request.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Unique logical launch request ID. Exact retry uses the same key/body."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LaunchRequest"
              },
              "example": {
                "symbol": "wildframes",
                "external_player_id": "player-123",
                "currency": "EUR",
                "lang": "en",
                "device": "desktop",
                "return_url": "https://client.example/lobby"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "symbol": "wildframes",
                    "operator_id": "client-a",
                    "currency": "EUR",
                    "lang": "en",
                    "session_id": "ses_example_01",
                    "launch_url": "https://aureviagaming.com/playngo-sandbox/runtime/wildframes/casino/ContainerLauncher?ticket=EXAMPLE_ONLY",
                    "expires_at": "2026-09-11T16:01:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid operator key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Inactive operator or disallowed resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Game unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retry.",
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          },
          "503": {
            "description": "Session capacity is occupied, new wagering is paused, or a dependency is unavailable",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds before retry"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with a different request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
