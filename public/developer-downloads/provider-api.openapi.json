  "components": {
    "securitySchemes": {
      "OperatorKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-provider-api-key"
      },
      "OperatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use operator key as bearer value."
      }
    },
    "schemas": {
      "Game": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "enum": [
              "demon",
              "honeyrush",
              "hugosadventure",
              "legacyofegypt",
              "moonprincess",
              "secretofdead",
              "trollhunters2",
              "wheelofmictlan",
              "wildframes"
            ],
            "description": "Initial candidate symbols. Actual assigned/enabled catalog is authoritative."
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string"
          },
          "provider_id": {
            "const": "playngo",
            "type": "string"
          },
          "launch_status": {
            "type": "string",
            "enum": [
              "stable"
            ]
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "object",
            "properties": {
              "gamble": {
                "type": "boolean"
              }
            },
            "required": [
              "gamble"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "symbol",
          "slug",
          "title",
          "provider_id",
          "launch_status"
        ],
        "additionalProperties": true
      },
      "CatalogResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true,
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "operator_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "provider_id": {
                "const": "playngo",
                "type": "string"
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            },
            "required": [
              "operator_id",
              "provider_id",
              "total",
              "items"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": true
      },
      "GameResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true,
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/Game"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "additionalProperties": true
      },
      "LaunchRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "enum": [
              "demon",
              "honeyrush",
              "hugosadventure",
              "legacyofegypt",
              "moonprincess",
              "secretofdead",
              "trollhunters2",
              "wheelofmictlan",
              "wildframes"
            ],
            "description": "Initial candidate symbols. Actual assigned/enabled catalog is authoritative."
          },
          "external_player_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Opaque, case-sensitive player ID. Preserve the exact Unicode characters, including whitespace. The provider does not trim or normalize this field. Derive it from the authenticated player on your server."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "EUR"
            ],
            "description": "Enabled two-fractional-digit currency only."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en"
            ],
            "default": "en"
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ],
            "default": "desktop"
          },
          "return_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Must use an approved client origin."
          }
        },
        "required": [
          "symbol",
          "external_player_id",
          "currency",
          "return_url"
        ],
        "additionalProperties": false
      },
      "LaunchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "const": true,
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "enum": [
                  "demon",
                  "honeyrush",
                  "hugosadventure",
                  "legacyofegypt",
                  "moonprincess",
                  "secretofdead",
                  "trollhunters2",
                  "wheelofmictlan",
                  "wildframes"
                ],
                "description": "Initial candidate symbols. Actual assigned/enabled catalog is authoritative."
              },
              "operator_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "examples": [
                  "EUR"
                ],
                "description": "Enabled two-fractional-digit currency only."
              },
              "lang": {
                "type": "string"
              },
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "launch_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "description": "Single-use opaque launch ticket. Valid 60 seconds from issuance."
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
